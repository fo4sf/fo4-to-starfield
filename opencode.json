{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "fo4-lead",
  "subagent_depth": 1,
  "instructions": ["AGENTS.md", "CONTRIBUTING.md", "docs/CODEX-HANDOFF.md"],
  "model": "guardian/fo4-lead",
  "enabled_providers": ["guardian", "anthropic"],
  "provider": {
    "guardian": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio via Resource Guardian (local)",
      "options": { "baseURL": "http://127.0.0.1:1235/v1", "headerTimeout": 900000 },
      "models": {
        "fo4-lead":      { "name": "Lead (local)",           "tool_call": true, "limit": { "context": 65536, "output": 32000 } },
        "fo4-implement": { "name": "Implementation (local)", "tool_call": true, "limit": { "context": 65536, "output": 32000 } },
        "fo4-research":  { "name": "Research (local)",       "tool_call": true, "limit": { "context": 65536, "output": 32000 } },
        "fo4-qa":        { "name": "QA (local)",             "tool_call": true, "limit": { "context": 65536, "output": 32000 } }
      }
    },
    "anthropic": {
      "whitelist": ["claude-sonnet-5-5", "claude-haiku-5-5"],
      "models": {
        "claude-sonnet-5-5": { "cost": { "input": 2,   "output": 10,  "cache_read": 0.2,  "cache_write": 2.5 },
                               "limit": { "context": 200000, "output": 32000 } },
        "claude-haiku-5-5":  { "cost": { "input": 0.1, "output": 0.5, "cache_read": 0.01, "cache_write": 0.125 },
                               "limit": { "context": 100000, "output": 32000 } }
      }
    }
  },
  "permission": {
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "skill": { "*": "deny", "fo4-*": "allow" },
    "bash": {
      "*": "ask",
      "git status*": "allow", "git diff*": "allow", "git log*": "allow", "git show*": "allow", "git branch*": "allow",
      "git worktree list*": "allow",
      "git push*": "deny", "git merge*": "deny", "git rebase*": "deny", "git reset --hard*": "deny",
      "git clean*": "deny", "git checkout -- *": "deny", "git stash*": "deny",
      "gh pr merge*": "deny", "gh repo delete*": "deny", "gh api*": "ask",
      "rm *": "deny", "del *": "deny", "Remove-Item*": "deny", "rmdir*": "deny", "format*": "deny",
      "python tools/ai-team/guardian/guardian.py status*": "allow",
      "python tools/ai-team/guardian/guardian.py report*": "allow",
      "python -I tools/ai-team/guardian/guardian.py status*": "allow",
      "python -I tools/ai-team/guardian/guardian.py report*": "allow",
      "git diff*--output*": "deny", "git log*--output*": "deny", "git show*--output*": "deny",
      "git diff*--no-index*": "deny",
      "*--output*": "deny", "*--no-index*": "deny", "*>*": "deny"
    }
  },
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  }
}
